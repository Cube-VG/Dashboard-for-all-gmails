# Copy this file to .env and fill it in. .env is never committed.

# --- AI (used from step 3; `python -m app.cli test-ai` checks it now) ---
OPENROUTER_API_KEY=sk-or-...
AI_MODEL=google/gemma-4-26b-a4b-it:free
AI_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
MAX_AI_CALLS_PER_DAY=50

# --- Mail sync ---
DB_PATH=data/inbox.db
ACCOUNTS_FILE=accounts.yaml
# On the very first sync, only fetch mail from the last N days...
SYNC_DAYS_BACK=14
# ...and at most this many messages per account.
MAX_INITIAL_MESSAGES=300
